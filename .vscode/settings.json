{
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "backend/data/chroma": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "backend/.venv": true,
    "backend/data/chroma": true,
    "**/package-lock.json": true
  }
}
