# Copy to .env and fill in a key. The service runs without one, in a clearly
# labelled extractive mode, so the product is always demonstrable.

# --- Model providers ---------------------------------------------------
# Get a Gemini key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
OPENAI_API_KEY=

# google | openai | none
LLM_PROVIDER=google
# google | openai | local   (local = bundled MiniLM ONNX model, no API key)
EMBEDDING_PROVIDER=google

GOOGLE_CHAT_MODEL=gemini-3.1-flash-lite
GOOGLE_EMBEDDING_MODEL=models/text-embedding-004
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Service -----------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8010
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Retrieval tuning --------------------------------------------------
CHUNK_SIZE=1100
CHUNK_OVERLAP=160
RETRIEVAL_TOP_K=6
# Weight of the lexical arm in hybrid retrieval (0 = pure vector search)
LEXICAL_WEIGHT=0.45
# Answers below this cosine similarity are refused and logged as coverage gaps
MIN_RELEVANCE_SCORE=0.48
HIGH_CONFIDENCE_SCORE=0.66
